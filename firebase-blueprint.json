{
  "entities": {
    "WorkoutLog": {
      "title": "WorkoutLog",
      "description": "Represents an athletic running workout logged via Strava AI screenshot OCR or manual entry.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Google user UID who owns this workout."
        },
        "title": {
          "type": "string",
          "description": "Workout title (e.g., Morning Threshold Run)."
        },
        "distanceKm": {
          "type": "number",
          "description": "Total distance run in kilometers."
        },
        "durationSeconds": {
          "type": "integer",
          "description": "Total moving time in seconds."
        },
        "avgPaceSecondsPerKm": {
          "type": "integer",
          "description": "Average pace in seconds per kilometer."
        },
        "avgHeartRate": {
          "type": "integer",
          "description": "Average heart rate in beats per minute (BPM)."
        },
        "cadenceSpm": {
          "type": "integer",
          "description": "Average running cadence in steps per minute (SPM)."
        },
        "elevationGainM": {
          "type": "integer",
          "description": "Total elevation gain in meters."
        },
        "splitsSummary": {
          "type": "string",
          "description": "Formatted per-kilometer split breakdown."
        },
        "aiCoachingInsight": {
          "type": "string",
          "description": "AI-generated physiological and pacing analysis for the workout."
        },
        "sourceType": {
          "type": "string",
          "enum": ["STRAVA_OCR", "MANUAL"],
          "description": "How the workout was logged."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "title",
        "distanceKm",
        "durationSeconds",
        "avgPaceSecondsPerKm",
        "avgHeartRate",
        "cadenceSpm",
        "elevationGainM",
        "splitsSummary",
        "aiCoachingInsight",
        "sourceType",
        "createdAt",
        "updatedAt"
      ]
    },
    "PersonalRecord": {
      "title": "PersonalRecord",
      "description": "Stores a runner's all-time Personal Record (PR) for a standard distance category.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Google user UID who owns this PR."
        },
        "distanceCategory": {
          "type": "string",
          "enum": ["5K", "10K", "HALF_MARATHON", "MARATHON"],
          "description": "Standard race distance bucket."
        },
        "distanceMeters": {
          "type": "integer",
          "description": "Exact race distance in meters."
        },
        "bestTimeSeconds": {
          "type": "integer",
          "description": "Fastest recorded finish time in seconds."
        },
        "previousTimeSeconds": {
          "type": "integer",
          "description": "Previous PR time in seconds (0 if first record)."
        },
        "paceSecondsPerKm": {
          "type": "integer",
          "description": "Average pace in seconds per kilometer."
        },
        "workoutTitle": {
          "type": "string",
          "description": "Name of the workout or race where the PR was set."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "distanceCategory",
        "distanceMeters",
        "bestTimeSeconds",
        "previousTimeSeconds",
        "paceSecondsPerKm",
        "workoutTitle",
        "createdAt",
        "updatedAt"
      ]
    },
    "TrainingGoal": {
      "title": "TrainingGoal",
      "description": "Target race time and weekly mileage goal with scheduled push reminders.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Google user UID who owns this goal."
        },
        "title": {
          "type": "string",
          "description": "Goal name (e.g., Sub-40 10K Autumn Peak)."
        },
        "targetDistanceCategory": {
          "type": "string",
          "enum": ["5K", "10K", "HALF_MARATHON", "MARATHON"],
          "description": "Target race distance category."
        },
        "targetTimeSeconds": {
          "type": "integer",
          "description": "Target finish time in seconds."
        },
        "weeklyMileageTargetKm": {
          "type": "integer",
          "description": "Target weekly running volume in kilometers."
        },
        "reminderEnabled": {
          "type": "boolean",
          "description": "Whether daily goal push reminders are enabled."
        },
        "reminderHour": {
          "type": "integer",
          "description": "Hour of day (0-23) for the push reminder."
        },
        "reminderMinute": {
          "type": "integer",
          "description": "Minute of hour (0-59) for the push reminder."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the goal has been achieved."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "title",
        "targetDistanceCategory",
        "targetTimeSeconds",
        "weeklyMileageTargetKm",
        "reminderEnabled",
        "reminderHour",
        "reminderMinute",
        "completed",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudBackupSnapshot": {
      "title": "CloudBackupSnapshot",
      "description": "Comprehensive cloud backup snapshot metadata and summary for multi-device recovery.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Google user UID who owns this backup."
        },
        "backupLabel": {
          "type": "string",
          "description": "Human-readable backup checkpoint label."
        },
        "workoutCount": {
          "type": "integer",
          "description": "Number of workouts captured in this checkpoint."
        },
        "prCount": {
          "type": "integer",
          "description": "Number of personal records captured in this checkpoint."
        },
        "goalCount": {
          "type": "integer",
          "description": "Number of active goals captured in this checkpoint."
        },
        "summaryNotes": {
          "type": "string",
          "description": "Serialized JSON or summary digest of training state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "backupLabel",
        "workoutCount",
        "prCount",
        "goalCount",
        "summaryNotes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/workouts/{workoutId}": {
      "schema": {
        "$ref": "#/entities/WorkoutLog"
      },
      "description": "Per-user logged running workouts from Strava OCR or manual entry."
    },
    "/users/{userId}/personalRecords/{prId}": {
      "schema": {
        "$ref": "#/entities/PersonalRecord"
      },
      "description": "Per-user Personal Records across standard running distances."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": {
        "$ref": "#/entities/TrainingGoal"
      },
      "description": "Per-user race goals, weekly mileage targets, and push reminder settings."
    },
    "/users/{userId}/backups/{backupId}": {
      "schema": {
        "$ref": "#/entities/CloudBackupSnapshot"
      },
      "description": "Per-user cloud backup checkpoints for training data durability."
    }
  }
}
